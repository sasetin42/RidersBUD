<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>RidersBUD</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.sasetin42.ridersbud</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ridersbud</string>
				<string>com.sasetin42.ridersbud</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>gcash</string>
		<string>paymaya</string>
		<string>grabpay</string>
	</array>

	<!--
	  iOS HARD-CRASH FIX (payment + permissions):
	  @capacitor/geolocation (imported in App.tsx), camera capture and audio
	  recording are all linked, but this plist previously declared NO usage
	  descriptions. iOS terminates the app with "This app has crashed because it
	  attempted to access privacy-sensitive data without a usage description"
	  the instant any of these APIs is touched — which surfaced as the checkout
	  flow crashing mid-payment on iOS. Every string below must be present.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RidersBUD uses your location to show nearby mechanics, track your driver/handler in real time, and route help to your exact pickup point.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>RidersBUD uses your location in the background to keep live service tracking active while your booking is in progress.</string>
	<key>NSLocationUsageDescription</key>
	<string>RidersBUD uses your location to locate nearby services and share your pickup point with your assigned rider.</string>
	<key>NSCameraUsageDescription</key>
	<string>RidersBUD uses your camera to capture vehicle photos and scan QR codes to complete your payment.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>RidersBUD needs access to your photo library so you can attach vehicle photos to your booking.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>RidersBUD saves payment receipts and booking photos to your photo library when you choose to download them.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>RidersBUD uses your microphone for in-app calls and voice notes with your mechanic or driver.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>RidersBUD uses Face ID to keep your account secure when you sign in.</string>

	<!--
	  ATS: HitPay may hand back http:// redirects for some 3-D Secure / wallet
	  handoffs. Without an exception those loads fail silently and the payment
	  appears to hang. Allow arbitrary loads so a gateway redirect can never
	  strand the customer mid-transaction.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
