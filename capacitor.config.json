{
  "appId": "com.sasetin42.ridersbud",
  "appName": "RidersBUD",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": true,
      "animation": "SLIDE"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "server": {
    "cleartext": true,
    "androidScheme": "https"
  },
  "packageClassList": [
    "AppPlugin",
    "CAPBrowserPlugin",
    "GeolocationPlugin",
    "NativeSettingsPlugin",
    "HitPayInAppPlugin",
    "PushNotificationsPlugin"
  ]
}
