rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    
    function isMechanic() {
      return isAuth() && exists(/databases/$(database)/documents/mechanics/$(request.auth.uid));
    }

    function isCustomer() {
      return isAuth() && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    // Guard: Prevent client writes from altering authoritative payment fields
    // Payment status & verification MUST only be modified server-side via Cloud Functions
    // (HitPay webhook, authoritative settlement, or markOfflinePayment callable).
    function cannotTamperPaymentFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus',
        'isPaid',
        'isVerified',
        'paidAmount',
        'remainingBalance',
        'balancePaid',
        'balancePaidAt',
        'balancePaymentRef',
        'downpaymentPaidAt',
        'downpaymentRef',
        'downpaymentAmount',
        'hitpayPaymentRequestId',
        'hitpayReference',
        'hitpayStatus',
        'paymentTransactions'
      ]);
    }

    // Customers
    match /customers/{userId} {
      allow read: if true;
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // Mechanics
    match /mechanics/{mechanicId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        isAdmin() || 
        isMechanic() ||
        resource.data.customerId == request.auth.uid || 
        resource.data.mechanicId == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.customerId == request.auth.uid &&
          (!("isPaid" in request.resource.data) || request.resource.data.isPaid == false) &&
          (!("isVerified" in request.resource.data) || request.resource.data.isVerified == false) &&
          (!("paymentStatus" in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'unpaid', 'deposit', null]) &&
          (!("paidAmount" in request.resource.data) || request.resource.data.paidAmount == 0 || request.resource.data.paidAmount == null)
        )
      );
      allow update: if isAuth() && (
        isAdmin() || 
        (
          (
            resource.data.customerId == request.auth.uid || 
            resource.data.mechanicId == request.auth.uid ||
            (isMechanic() && (!("mechanicId" in resource.data) || resource.data.mechanicId == null))
          ) &&
          cannotTamperPaymentFields()
        )
      );
      allow delete: if isAdmin();

      // Messages inside bookings
      match /messages/{messageId} {
        allow read, write: if isAuth();
      }
    }

    // Support Chats
    match /support_chats/{userId} {
      allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Support Satisfaction Reviews
    match /support_satisfaction/{feedbackId} {
      allow read: if isAuth() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Orders (for parts)
    match /orders/{orderId} {
      allow read: if isAuth() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.customerId == request.auth.uid &&
          (!("isPaid" in request.resource.data) || request.resource.data.isPaid == false) &&
          (!("paymentStatus" in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'unpaid', null])
        )
      );
      allow update: if isAuth() && (
        isAdmin() || 
        (
          resource.data.customerId == request.auth.uid &&
          cannotTamperPaymentFields()
        )
      );
      allow delete: if isAdmin();
    }

    // Tasks (for mechanics)
    match /tasks/{taskId} {
      allow read: if isAuth() && (isAdmin() || resource.data.mechanicId == request.auth.uid);
      allow write: if isAdmin() || (isAuth() && resource.data.mechanicId == request.auth.uid);
    }

    // Payouts
    match /payouts/{payoutId} {
      allow read: if isAuth() && (isAdmin() || resource.data.mechanicId == request.auth.uid);
      allow create: if isAuth() && (isAdmin() || request.resource.data.mechanicId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      function validNotifRole() {
        return request.resource.data.recipientRole in ['customer', 'mechanic', 'admin'];
      }

      allow read: if isAuth() && (
        isAdmin() ||
        (
          isMechanic() && 
          resource.data.recipientRole == "mechanic" && 
          (resource.data.recipientId == request.auth.uid || resource.data.recipientId == "all" || resource.data.recipientId == "mechanic-" + request.auth.uid)
        ) ||
        (
          isCustomer() && 
          (resource.data.recipientId == request.auth.uid || resource.data.recipientId == "all" || resource.data.recipientId == "customer-" + request.auth.uid) && 
          (!("recipientRole" in resource.data) || resource.data.recipientRole == "customer" || resource.data.recipientRole == null || resource.data.recipientRole == "")
        )
      );

      allow create: if isAuth() && validNotifRole();

      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == "customer-" + request.auth.uid ||
        resource.data.recipientId == "mechanic-" + request.auth.uid
      );

      allow delete: if isAuth() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == "customer-" + request.auth.uid ||
        resource.data.recipientId == "mechanic-" + request.auth.uid
      );
    }

    // Public readable collections
    match /services/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /parts/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    // SECURITY: payment gateway secrets doc & logs — admins only, never public
    match /settings/hitpaySecrets { allow read, write: if isAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /promoCodes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /smtpLogs/{document=**} { allow read, write: if isAdmin(); }
    match /paymentWebhookLogs/{document=**} { allow read, write: if isAdmin(); }
    match /paymentWebhookEvents/{document=**} { allow read, write: if isAdmin(); }
    match /adminNotifications/{document=**} { allow read, write: if isAdmin(); }
    
    // Admin Users
    match /adminUsers/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /rentalCars/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /hireDrivers/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    // Rental Bookings
    match /rentalBookings/{rentalId} { 
      allow read: if isAuth() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.customerId == request.auth.uid &&
          (!("isPaid" in request.resource.data) || request.resource.data.isPaid == false) &&
          (!("paidAmount" in request.resource.data) || request.resource.data.paidAmount == 0 || request.resource.data.paidAmount == null)
        )
      );
      allow update: if isAuth() && (
        isAdmin() || 
        (
          resource.data.customerId == request.auth.uid &&
          cannotTamperPaymentFields()
        )
      );
      allow delete: if isAdmin();
    }
    
    match /subscriptions/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    // RidersBud Services
    match /appServices/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /serviceProviders/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /servicePricing/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // Service Requests (Driver hire, Towing, Roadside Assistance)
    match /serviceRequests/{requestId} {
      allow read: if isAuth() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.customerId == request.auth.uid &&
          (!("isPaid" in request.resource.data) || request.resource.data.isPaid == false) &&
          (!("paidAmount" in request.resource.data) || request.resource.data.paidAmount == 0 || request.resource.data.paidAmount == null)
        )
      );
      allow update: if isAuth() && (
        isAdmin() || 
        (
          resource.data.customerId == request.auth.uid &&
          cannotTamperPaymentFields()
        )
      );
      allow delete: if isAdmin();
    }

    match /serviceActivityLogs/{logId} {
      allow read: if isAuth() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if isAuth() && (isAdmin() || request.resource.data.customerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Liaison System
    match /liaisonStaff/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /liaisonBranches/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /liaisonBookings/{bookingId} {
      allow read: if isAuth() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.customerId == request.auth.uid &&
          (!("isPaid" in request.resource.data) || request.resource.data.isPaid == false) &&
          (!("paidAmount" in request.resource.data) || request.resource.data.paidAmount == 0 || request.resource.data.paidAmount == null)
        )
      );
      allow update: if isAuth() && (
        isAdmin() || 
        (
          resource.data.customerId == request.auth.uid &&
          cannotTamperPaymentFields()
        )
      );
      allow delete: if isAdmin();
    }

    // Payment transactions (paymentTransactions/{transactionId}) are written ONLY
    // by Cloud Functions (Admin SDK bypasses rules). Clients can ONLY read transactions
    // belonging to them or if they are admin. Direct client writes are strictly forbidden.
    match /paymentTransactions/{transactionId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid
      );
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
